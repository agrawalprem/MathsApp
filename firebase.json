<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>Learning Maths in Baby Steps</title>
    <link rel="stylesheet" href="shared.css">
    <style>
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 14px;
            margin: 20px 0;
        }
        .card {
            background: #ffffff;
            border: 1.5px solid #3b82f6;
            border-radius: 8px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 4px rgba(59, 130, 246, 0.1);
            position: relative;
        }
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(59, 130, 246, 0.15);
            border-color: #2563eb;
        }
        .card-header {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 0;
            position: relative;
            padding-bottom: 8px;
        }
        .card-header h2 {
            margin: 0;
            color: #1e40af;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
            letter-spacing: 0.1px;
        }
        .card-toggle {
            position: absolute;
            right: 0;
            font-size: 14px;
            color: #3b82f6;
            user-select: none;
            transition: transform 0.2s ease;
        }
        .card:hover .card-toggle {
            transform: scale(1.1);
        }
        .card-content {
            display: none;
            color: #475569;
            line-height: 1.5;
            padding-top: 10px;
            font-size: 12px;
        }
        .card-content * {
            pointer-events: auto;
        }
        .card-content button,
        .card-content input {
            pointer-events: auto;
        }
        .card-content.show {
            display: block;
            animation: fadeIn 0.2s ease;
        }
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-3px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .card.inactive {
            opacity: 0.6;
        }
        .card.inactive .card-header {
            cursor: pointer;
        }
        .card.active {
            opacity: 1;
        }
        input {
            width: 100%;
            padding: 8px 10px;
            margin: 6px 0;
            box-sizing: border-box;
            border: 1.5px solid #3b82f6;
            border-radius: 6px;
            font-size: 13px;
            transition: all 0.2s ease;
            background: #ffffff;
        }
        input:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.1);
            background: #ffffff;
        }
        input:disabled {
            background-color: #f5f5f5;
            cursor: not-allowed;
            opacity: 0.6;
        }
        .password-input-wrapper {
            position: relative;
            width: 100%;
        }
        .password-input-wrapper input {
            padding-right: 45px;
        }
        .password-toggle {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            font-size: 16px;
            padding: 4px;
            color: #3b82f6;
            width: auto;
            margin: 0;
        }
        .password-toggle:hover {
            color: #2563eb;
        }
        button {
            width: 100%;
            padding: 8px 12px;
            margin: 6px 0;
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s ease;
            box-shadow: 0 1px 2px rgba(59, 130, 246, 0.2);
        }
        button:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
        }
        button:active:not(:disabled) {
            transform: translateY(0);
            box-shadow: 0 1px 2px rgba(59, 130, 246, 0.2);
        }
        button:disabled {
            background: #e2e8f0;
            color: #94a3b8;
            cursor: not-allowed;
            box-shadow: none;
        }
        .reset-button {
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%) !important;
            box-shadow: 0 1px 2px rgba(59, 130, 246, 0.2) !important;
        }
        .reset-button:hover {
            box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3) !important;
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%) !important;
        }
        #loginButton:not(:disabled) {
            background: linear-gradient(135deg, #60a5fa 0%, #93c5fd 100%) !important;
            box-shadow: 0 1px 2px rgba(147, 197, 253, 0.2) !important;
        }
        #loginButton:not(:disabled):hover {
            box-shadow: 0 2px 4px rgba(147, 197, 253, 0.3) !important;
            background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%) !important;
        }
        .error {
            color: #dc2626;
            margin: 6px 0;
            padding: 8px 10px;
            background: #fef2f2;
            border-radius: 5px;
            border-left: 2px solid #ef4444;
            font-size: 12px;
        }
        .success {
            color: #1e40af;
            margin: 6px 0;
            padding: 8px 10px;
            background: #eff6ff;
            border-radius: 5px;
            border-left: 2px solid #3b82f6;
            font-size: 12px;
        }
        .admin-contact {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            padding: 10px 12px;
            border-radius: 6px;
            border-left: 2px solid #3b82f6;
            box-shadow: 0 1px 2px rgba(59, 130, 246, 0.1);
        }
        .admin-contact h4 {
            margin-top: 0;
            margin-bottom: 8px;
            color: #1e40af;
            font-weight: 600;
            font-size: 14px;
        }
        .admin-contact p {
            margin: 6px 0;
            color: #1e3a8a;
            line-height: 1.5;
            font-size: 12px;
        }
        .admin-contact a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }
        .admin-contact a:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }
        ul {
            margin: 10px 0;
            padding-left: 20px;
        }
        li {
            margin: 5px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 style="text-align: center; color: #1e40af; margin-bottom: 12px; font-size: 22px; font-weight: 700; letter-spacing: -0.3px;">Learning Maths in Baby Steps</h1>
        
        <div class="cards-grid">
            <!-- Card 1: Login (Dynamic - Active when logged out) -->
            <div class="card" id="loginCard">
                <div class="card-header" onclick="toggleCard('login')">
                    <h2>Login</h2>
                    <span class="card-toggle" id="loginToggle">▼</span>
                </div>
                <div class="card-content" id="loginContent">
                    <div id="loginErrorMessage" class="error" style="display: none;"></div>
                    <div id="loginSuccessMessage" class="success" style="display: none;"></div>
                    
                    <!-- User Code Entry -->
                    <div id="loginStep1">
                        <input type="text" id="userCode" placeholder="Enter Usercode" maxlength="6" pattern="[0-9]{6}" autocomplete="off" />
                    </div>
                    
                    <!-- User Details Display -->
                    <div id="userDetails" style="display: none; margin-bottom: 10px; padding: 10px 12px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-radius: 6px; border-left: 2px solid #3b82f6;">
                        <p style="margin: 3px 0; font-size: 12px; color: #1e3a8a;"><strong style="color: #1e40af;">Name:</strong> <span id="userNameDisplay" style="color: #2563eb;"></span></p>
                        <p style="margin: 3px 0; font-size: 12px; color: #1e3a8a;"><strong style="color: #1e40af;">School:</strong> <span id="userSchool" style="color: #2563eb;"></span></p>
                        <p style="margin: 3px 0; font-size: 12px; color: #1e3a8a;"><strong style="color: #1e40af;">Class:</strong> <span id="userClass" style="color: #2563eb;"></span></p>
                        <p style="margin: 3px 0; font-size: 12px; color: #1e3a8a;"><strong style="color: #1e40af;">Section:</strong> <span id="userSection" style="color: #2563eb;"></span></p>
                        <p style="margin: 3px 0; font-size: 12px; color: #1e3a8a;"><strong style="color: #1e40af;">Roll Number:</strong> <span id="userRollNumber" style="color: #2563eb;"></span></p>
                    </div>
                    
                    <!-- Password Field -->
                    <div class="password-input-wrapper">
                        <input type="password" id="password" placeholder="Enter 6-digit Password" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" disabled onkeypress="if(event.key === 'Enter') loginWithUserCode()" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        <button type="button" class="password-toggle" id="passwordToggle" onclick="togglePasswordVisibility()" aria-label="Show password" style="display: none;">👁️</button>
                    </div>
                    <button onclick="loginWithUserCode()" id="loginButton" disabled>Log In</button>
                    <button onclick="resetLoginForm()" class="reset-button">Reset</button>
                </div>
                </div>
                
            <!-- Card 2: Logout (Dynamic - Active when logged in) -->
            <div class="card" id="logoutCard">
                <div class="card-header" onclick="toggleCard('logout')">
                    <h2>Logout</h2>
                    <span class="card-toggle" id="logoutToggle">▼</span>
                </div>
                <div class="card-content" id="logoutContent">
                    <div id="logoutErrorMessage" class="error" style="display: none;"></div>
                    <div id="logoutSuccessMessage" class="success" style="display: none;"></div>
                    <div id="userInfoDisplay" style="margin-bottom: 10px; padding: 10px 12px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-radius: 6px; border-left: 2px solid #3b82f6;">
                        <p style="margin: 3px 0; font-size: 12px; color: #1e40af; font-weight: 600;"><strong>Logged in as:</strong></p>
                        <p style="margin: 3px 0; font-size: 12px; color: #1e3a8a;" id="logoutUserEmail"></p>
                        <p style="margin: 3px 0; font-size: 12px; color: #1e3a8a;" id="logoutUserName"></p>
                        <p style="margin: 3px 0; font-size: 12px; color: #1e3a8a;" id="logoutUserType"></p>
                    </div>
                    <button onclick="handleLogout()">Sign Out</button>
                </div>
            </div>
            
            <!-- Card 3: Anonymous User (Always Available) -->
            <div class="card">
                <div class="card-header" onclick="toggleCard('anonymous')">
                    <h2>Anonymous User</h2>
                    <span class="card-toggle" id="anonymousToggle">▼</span>
                </div>
                <div class="card-content" id="anonymousContent">
                    <div id="anonymousErrorMessage" class="error" style="display: none;"></div>
                    <div id="anonymousSuccessMessage" class="success" style="display: none;"></div>
                    <p style="margin-bottom: 10px; font-size: 12px; color: #475569;">Continue without an account? Your progress will not be saved.</p>
                    <button onclick="signInAnonymously()">Continue as Anonymous User</button>
                </div>
            </div>
            
            <!-- Card 4: Welcome (Static) -->
            <div class="card">
                <div class="card-header" onclick="toggleCard('welcome')">
                    <h2>Welcome</h2>
                    <span class="card-toggle" id="welcomeToggle">▼</span>
                </div>
                <div class="card-content" id="welcomeContent">
                    <p style="margin-bottom: 10px; color: #475569; line-height: 1.5; font-size: 12px;">Welcome to this new method of teaching children the fundamentals of arithmetic. The object of this method is to make children fluent in</p>
                    
                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin: 10px 0;">
                        <div style="padding: 8px; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); border-radius: 5px; text-align: center; font-weight: 600; color: white; font-size: 11px; border: 1px solid #1d4ed8;">Single-digit addition</div>
                        <div style="padding: 8px; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); border-radius: 5px; text-align: center; font-weight: 600; color: white; font-size: 11px; border: 1px solid #1d4ed8;">Single-digit subtraction</div>
                        <div style="padding: 8px; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); border-radius: 5px; text-align: center; font-weight: 600; color: white; font-size: 11px; border: 1px solid #1d4ed8;">Single-digit multiplication</div>
                        <div style="padding: 8px; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); border-radius: 5px; text-align: center; font-weight: 600; color: white; font-size: 11px; border: 1px solid #1d4ed8;">Single-digit division</div>
                    </div>
                    
                    <p style="margin-top: 10px; margin-bottom: 10px; color: #475569; line-height: 1.5; font-size: 12px;">The emphasis is on practice and perfection. Both speed and accuracy are important. Each child learns at her own pace and the progress of each child is tracked. Apart from single digit operations, children also learn the art of mental calculation in</p>
                    
                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin: 10px 0;">
                        <div style="padding: 8px; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); border-radius: 5px; text-align: center; font-weight: 600; color: white; font-size: 11px; border: 1px solid #1d4ed8;">Multi-digit addition</div>
                        <div style="padding: 8px; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); border-radius: 5px; text-align: center; font-weight: 600; color: white; font-size: 11px; border: 1px solid #1d4ed8;">Multi-digit subtraction</div>
                        <div style="padding: 8px; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); border-radius: 5px; text-align: center; font-weight: 600; color: white; font-size: 11px; border: 1px solid #1d4ed8;">Multi-digit multiplication by 1-digit</div>
                        <div style="padding: 8px; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); border-radius: 5px; text-align: center; font-weight: 600; color: white; font-size: 11px; border: 1px solid #1d4ed8;">Multi-digit division by 1-digit</div>
                    </div>
                    
                    <ul style="margin: 10px 0; padding-left: 18px; color: #475569; line-height: 1.5; font-size: 12px;">
                        <li style="margin-bottom: 4px;">Multi-digit addition and multiplication are done without writing carry.</li>
                        <li style="margin-bottom: 4px;">Multi-digit subtraction is done without writing borrowing.</li>
                        <li style="margin-bottom: 4px;">Multi-digit division is done without writing remainder.</li>
                    </ul>
                    
                    <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin: 12px 0; padding: 10px; background: #eff6ff; border-radius: 6px;">
                        <div style="padding: 6px 12px; background: #fee2e2; border-radius: 5px; font-weight: 600; color: #991b1b; font-size: 12px; border: 1px solid #fecaca;">I hate Maths</div>
                        <div style="font-size: 18px; color: #3b82f6;">→</div>
                        <div style="padding: 6px 12px; background: #dbeafe; border-radius: 5px; font-weight: 600; color: #1e40af; font-size: 12px; border: 1px solid #93c5fd;">I love Maths</div>
                    </div>
                    
                    <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #dbeafe; text-align: center; font-size: 11px; color: #1e3a8a;">
                        <div style="margin-bottom: 3px;"><strong style="color: #1e40af;">Prem Agrawal</strong></div>
                        <div style="margin-bottom: 3px;"><a href="mailto:agrawal.prem@gmail.com" style="color: #2563eb; text-decoration: none;">agrawal.prem@gmail.com</a></div>
                        <div>+91 9822847682</div>
                    </div>
                </div>
            </div>
            
            <!-- Card 5: Registration (Static) -->
            <div class="card">
                <div class="card-header" onclick="toggleCard('registration')">
                    <h2>Registration</h2>
                    <span class="card-toggle" id="registrationToggle">▼</span>
                </div>
                <div class="card-content" id="registrationContent">
                    <div class="admin-contact">
                        <h4>Account creation is done by the Administrator</h4>
                        <p>To register for an account, please contact the Administrator:</p>
                        <p><strong>Prem Agrawal</strong><br>
                        Email: <a href="mailto:agrawal.prem@gmail.com">agrawal.prem@gmail.com</a><br>
                        Phone: <a href="tel:+919822847682">+91 98228 47682</a> (WhatsApp)</p>
                    </div>
                </div>
            </div>
                
            <!-- Card 6: Reset Password (Static) -->
            <div class="card">
                <div class="card-header" onclick="toggleCard('resetPassword')">
                    <h2>Reset Password</h2>
                    <span class="card-toggle" id="resetPasswordToggle">▼</span>
                </div>
                <div class="card-content" id="resetPasswordContent">
                    <div class="admin-contact">
                        <h4>Password reset is done by the Administrator</h4>
                        <p>To reset your password, please contact the Administrator:</p>
                        <p><strong>Prem Agrawal</strong><br>
                        Email: <a href="mailto:agrawal.prem@gmail.com">agrawal.prem@gmail.com</a><br>
                        Phone: <a href="tel:+919822847682">+91 98228 47682</a> (WhatsApp)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inline JavaScript for card toggles (self-contained) -->
    <script>
        // Toggle function for all cards (Login, Logout, Anonymous, Welcome, Registration, Reset Password)
        function toggleCard(cardId) {
            // Close all other cards first
            const allCards = ['login', 'logout', 'anonymous', 'welcome', 'registration', 'resetPassword'];
            allCards.forEach(id => {
                if (id !== cardId) {
                    const content = document.getElementById(id + 'Content');
                    const toggle = document.getElementById(id + 'Toggle');
                    if (content && toggle) {
                        content.classList.remove('show');
                        toggle.textContent = '▼';
                    }
                }
            });
            
            // Toggle the clicked card
            const content = document.getElementById(cardId + 'Content');
            const toggle = document.getElementById(cardId + 'Toggle');
            
            if (content && toggle) {
                if (content.classList.contains('show')) {
                    content.classList.remove('show');
                    toggle.textContent = '▼';
                    // Clear login form when login card is closed
                    if (cardId === 'login') {
                        if (typeof resetLoginForm === 'function') {
                            resetLoginForm();
                        }
                    }
                } else {
                    content.classList.add('show');
                    toggle.textContent = '▲';
                    // Always clear login form when login card is opened
                    if (cardId === 'login') {
                        if (typeof resetLoginForm === 'function') {
                            resetLoginForm();
                        }
                    }
                }
            }
        }
    </script>

    <!-- Firebase Module Script -->
    <script type="module">
        // Import Firebase SDKs
        import { initializeApp } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-app.js";
        import { getAnalytics } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-analytics.js";
        import { getAuth, signInAnonymously, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-auth.js";
        import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-firestore.js";
        
        // Firebase configuration
        const firebaseConfig = {
            apiKey: "AIzaSyBqCWeT44wwh92OL_8O0-j4IBwLeOaGSmc",
            authDomain: "maths-in-baby-steps.firebaseapp.com",
            projectId: "maths-in-baby-steps",
            storageBucket: "maths-in-baby-steps.firebasestorage.app",
            messagingSenderId: "235467885199",
            appId: "1:235467885199:web:dff119a28e6f897d1dfefa",
            measurementId: "G-XKB7TT32RL"
        };

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const analytics = getAnalytics(app);
        const auth = getAuth(app);
        const db = getFirestore(app);
        
        console.log('✅ Firebase initialized successfully');
        
        // Store user profile for login step 2
        let loginUserProfile = null;
        
        // Password visibility toggle
        window.togglePasswordVisibility = function() {
            const passwordInput = document.getElementById('password');
            const toggleButton = document.getElementById('passwordToggle');
            if (!passwordInput || !toggleButton) return;
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleButton.textContent = '🙈';
                toggleButton.setAttribute('aria-label', 'Hide password');
            } else {
                passwordInput.type = 'password';
                toggleButton.textContent = '👁️';
                toggleButton.setAttribute('aria-label', 'Show password');
            }
        };
        
        // Step 1: Fetch user details by user code
        window.fetchUserDetails = async function() {
            const userCode = document.getElementById('userCode').value.trim();
            const errorEl = document.getElementById('loginErrorMessage');
            const successEl = document.getElementById('loginSuccessMessage');
            
            errorEl.style.display = 'none';
            successEl.style.display = 'none';
            errorEl.textContent = '';
            successEl.textContent = '';
            
            // Validate user code format
            if (!/^\d{6}$/.test(userCode)) {
                errorEl.textContent = 'Please enter a valid 6-digit user code';
                errorEl.style.display = 'block';
                return;
            }
            
            try {
                console.log('🔍 Looking up user code:', userCode);
                
                // Look up user profile in Firestore by user_code
                const userProfileRef = doc(db, 'user_profiles', userCode);
                const userProfileSnap = await getDoc(userProfileRef);
                
                if (!userProfileSnap.exists()) {
                    errorEl.textContent = 'User Code not Found';
                    errorEl.style.display = 'block';
                    console.log('❌ User profile not found for code:', userCode);
                    return;
                }
                
                const userProfile = userProfileSnap.data();
                console.log('✅ User profile found:', userProfile);
                
                // Store profile for login step
                loginUserProfile = userProfile;
                
                // Display user details
                const fullName = [userProfile.first_name, userProfile.last_name].filter(Boolean).join(' ') || 'N/A';
                document.getElementById('userNameDisplay').textContent = fullName;
                document.getElementById('userSchool').textContent = userProfile.school_id || 'N/A';
                document.getElementById('userClass').textContent = userProfile.class || 'N/A';
                document.getElementById('userSection').textContent = userProfile.section || 'N/A';
                document.getElementById('userRollNumber').textContent = userProfile.roll_number || 'N/A';
                
                // Show user details, enable password field, and focus it
                document.getElementById('userDetails').style.display = 'block';
                const passwordInput = document.getElementById('password');
                const passwordToggle = document.getElementById('passwordToggle');
                const loginButton = document.getElementById('loginButton');
                
                passwordInput.disabled = false;
                passwordToggle.style.display = 'block';
                loginButton.disabled = false;
                passwordInput.focus();
                
            } catch (error) {
                console.error('❌ Error:', error);
                errorEl.textContent = 'Error looking up user. Please try again.';
                errorEl.style.display = 'block';
            }
        };
        
        // Step 2: Login with password
        window.loginWithUserCode = async function() {
            const password = document.getElementById('password').value;
            const userCode = document.getElementById('userCode').value.trim();
            const errorEl = document.getElementById('loginErrorMessage');
            const successEl = document.getElementById('loginSuccessMessage');
            
            errorEl.style.display = 'none';
            successEl.style.display = 'none';
            errorEl.textContent = '';
            successEl.textContent = '';
            
            // Validate password (must be 6 digits)
            if (!password || password.trim() === '') {
                errorEl.textContent = 'Please enter your password';
                errorEl.style.display = 'block';
                return;
            }
            if (!/^\d{6}$/.test(password)) {
                errorEl.textContent = 'Password must be exactly 6 digits';
                errorEl.style.display = 'block';
                return;
            }
            
            // Check if user profile was fetched
            if (!loginUserProfile) {
                errorEl.textContent = 'Please enter user code and click Continue first.';
                errorEl.style.display = 'block';
                return;
            }
            
            try {
                // Get email from user profile (stored in user_profiles for login)
                const email = loginUserProfile.email;
                if (!email) {
                    errorEl.textContent = 'User email not found. Please contact administrator.';
                    errorEl.style.display = 'block';
                    console.log('❌ No email in user profile');
                    return;
                }
                
                console.log('🔑 Attempting login with email:', email);
                
                // Sign in with Firebase Auth using email/password
                try {
                    const userCredential = await signInWithEmailAndPassword(auth, email, password);
                    console.log('✅ User signed in:', userCredential.user.uid);
                    
                    // Store user profile globally and in sessionStorage for use in other pages
                    window.currentUserProfile = loginUserProfile;
                    sessionStorage.setItem('currentUserProfile', JSON.stringify(loginUserProfile));
                    console.log('✅ User profile stored in sessionStorage');
                    
                    // Clear all form fields for security
                    document.getElementById('userCode').value = '';
                    document.getElementById('password').value = '';
                    
                    // Show success message briefly before redirect
                    successEl.textContent = 'Logged in successfully! Redirecting...';
                    successEl.style.display = 'block';
                    
                    // Redirect to student dashboard after a short delay
                    console.log('🔄 Redirecting to student-dashboard.html...');
                    setTimeout(() => {
                        window.location.href = 'student-dashboard.html';
                    }, 500);
                    
                } catch (authError) {
                    console.error('❌ Auth error:', authError);
                    if (authError.code === 'auth/user-not-found') {
                        errorEl.textContent = 'User account not found. Please contact administrator.';
                    } else if (authError.code === 'auth/wrong-password' || authError.code === 'auth/invalid-credential') {
                        errorEl.textContent = 'Invalid password';
                    } else if (authError.code === 'auth/invalid-email') {
                        errorEl.textContent = 'Invalid email. Please contact administrator.';
                    } else {
                        errorEl.textContent = authError.message || 'Login failed';
                    }
                    errorEl.style.display = 'block';
                }
                
            } catch (error) {
                console.error('❌ Error:', error);
                errorEl.textContent = 'Error during login. Please try again.';
                errorEl.style.display = 'block';
            }
        };
        
        // Reset login form
        window.resetLoginForm = function() {
            loginUserProfile = null;
            document.getElementById('userDetails').style.display = 'none';
            const userCodeInput = document.getElementById('userCode');
            const passwordInput = document.getElementById('password');
            const passwordToggle = document.getElementById('passwordToggle');
            const loginButton = document.getElementById('loginButton');
            
            // Clear user code field
            if (userCodeInput) {
                userCodeInput.value = '';
            }
            passwordInput.value = '';
            passwordInput.disabled = true;
            passwordInput.type = 'password'; // Reset to password type
            passwordToggle.style.display = 'none';
            loginButton.disabled = true;
            document.getElementById('loginErrorMessage').style.display = 'none';
            document.getElementById('loginSuccessMessage').style.display = 'none';
            document.getElementById('loginErrorMessage').textContent = '';
            document.getElementById('loginSuccessMessage').textContent = '';
        };
        
        // Sign in anonymously
        window.signInAnonymously = async function() {
            const errorEl = document.getElementById('anonymousErrorMessage');
            const successEl = document.getElementById('anonymousSuccessMessage');
            
            errorEl.style.display = 'none';
            successEl.style.display = 'none';
            errorEl.textContent = '';
            successEl.textContent = '';
            
            try {
                const userCredential = await signInAnonymously(auth);
                console.log('✅ Anonymous user signed in:', userCredential.user.uid);
                successEl.textContent = 'Signed in as Anonymous User. Redirecting...';
                successEl.style.display = 'block';
                
                // Redirect to student dashboard
                setTimeout(() => {
                    window.location.href = 'student-dashboard.html';
                }, 500);
            } catch (error) {
                console.error('❌ Anonymous sign in error:', error);
                errorEl.textContent = error.message;
                errorEl.style.display = 'block';
            }
        };
        
        // Handle logout
        window.handleLogout = async function() {
            const errorEl = document.getElementById('logoutErrorMessage');
            const successEl = document.getElementById('logoutSuccessMessage');
            
            errorEl.style.display = 'none';
            successEl.style.display = 'none';
            errorEl.textContent = '';
            successEl.textContent = '';
            
            try {
                await signOut(auth);
                console.log('✅ User signed out');
                sessionStorage.removeItem('currentUserProfile');
                successEl.textContent = 'Signed out successfully!';
                successEl.style.display = 'block';
            } catch (error) {
                console.error('❌ Sign out error:', error);
                errorEl.textContent = error.message;
                errorEl.style.display = 'block';
            }
        };
        
        // Monitor auth state changes and update card visibility
        onAuthStateChanged(auth, async (user) => {
            const loginCard = document.getElementById('loginCard');
            const logoutCard = document.getElementById('logoutCard');
            const logoutUserEmail = document.getElementById('logoutUserEmail');
            const logoutUserName = document.getElementById('logoutUserName');
            const logoutUserType = document.getElementById('logoutUserType');
            
            if (user) {
                // User is signed in - Visual indication only (cards still toggleable)
                loginCard.classList.remove('active');
                loginCard.classList.add('inactive');
                logoutCard.classList.remove('inactive');
                logoutCard.classList.add('active');
                // Ensure logout card content is closed initially
                const logoutContent = document.getElementById('logoutContent');
                const logoutToggle = document.getElementById('logoutToggle');
                if (logoutContent && logoutToggle && !logoutContent.classList.contains('show')) {
                    logoutContent.classList.remove('show');
                    logoutToggle.textContent = '▼';
                }
                
                if (user.isAnonymous) {
                    console.log('✅ Anonymous user is signed in');
                    logoutUserEmail.textContent = 'Anonymous User';
                    logoutUserName.textContent = '';
                    logoutUserType.textContent = '';
                } else {
                    console.log('✅ User is signed in:', user.email);
                    logoutUserEmail.textContent = user.email || 'User';
                    
                    // Fetch user profile to display name and type
                    try {
                        // First check window.currentUserProfile (set during login flow)
                        // If not available, load from sessionStorage (persists across page refreshes)
                        let profile = window.currentUserProfile;
                        if (!profile) {
                            const storedProfile = sessionStorage.getItem('currentUserProfile');
                            if (storedProfile) {
                                profile = JSON.parse(storedProfile);
                                // Also set it on window for consistency
                                window.currentUserProfile = profile;
                            }
                        }
                        
                        if (profile) {
                            const fullName = [profile.first_name, profile.last_name].filter(Boolean).join(' ') || 'N/A';
                            logoutUserName.textContent = `Name: ${fullName}`;
                            logoutUserType.textContent = `Type: ${profile.user_type || 'N/A'}`;
                        } else {
                            logoutUserName.textContent = '';
                            logoutUserType.textContent = '';
                        }
                    } catch (error) {
                        console.error('Error fetching user profile:', error);
                        logoutUserName.textContent = '';
                        logoutUserType.textContent = '';
                    }
                }
            } else {
                // User is signed out - Visual indication only (cards still toggleable)
                loginCard.classList.remove('inactive');
                loginCard.classList.add('active');
                logoutCard.classList.remove('active');
                logoutCard.classList.add('inactive');
                // Ensure login card content is closed initially and clear form
                const loginContent = document.getElementById('loginContent');
                const loginToggle = document.getElementById('loginToggle');
                if (loginContent && loginToggle && !loginContent.classList.contains('show')) {
                    loginContent.classList.remove('show');
                    loginToggle.textContent = '▼';
                }
                // Clear login form when user signs out
                if (typeof resetLoginForm === 'function') {
                    resetLoginForm();
                }
                
                console.log('ℹ️ User is signed out');
                window.currentUserProfile = null;
                
                // Reset login form
                resetLoginForm();
            }
        });
        
        // Auto-fetch user details when 6 digits are entered in user code field
        // Wait for DOM to be ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                setupAutoFetch();
                // Clear userCode field on page load to prevent showing last used code
                const userCodeInput = document.getElementById('userCode');
                if (userCodeInput) {
                    userCodeInput.value = '';
                }
            });
        } else {
            setupAutoFetch();
            // Clear userCode field on page load to prevent showing last used code
            const userCodeInput = document.getElementById('userCode');
            if (userCodeInput) {
                userCodeInput.value = '';
            }
        }
        
        function setupAutoFetch() {
            const userCodeInput = document.getElementById('userCode');
            if (userCodeInput) {
                userCodeInput.addEventListener('input', function() {
                    const userCode = this.value.trim();
                    // Auto-fetch when exactly 6 digits are entered
                    if (/^\d{6}$/.test(userCode)) {
                        fetchUserDetails();
                    }
                });
            }
        }
    </script>
</body>
</html>
